// @ts-nocheck
declare const THREE: any;
declare var scene: any;
declare var camera: any;
declare var renderer: any;
declare var controls: any;
declare var clock: any;
declare var hud: HTMLElement;

function createOrbitLine(radius, color = 0xffffff) {
  const segments = 128;
  const points = [];
  for (let i = 0; i <= segments; i++) {
    const theta = (i / segments) * Math.PI * 2;
    points.push(new THREE.Vector3(Math.cos(theta) * radius, 0, Math.sin(theta) * radius));
  }
  const geometry = new THREE.BufferGeometry().setFromPoints(points);
  const material = new THREE.LineBasicMaterial({ color, transparent: true, opacity: 0.3 });
  return new THREE.Line(geometry, material);
}

function createOrbitalPivot(
  distance,
  initialAngle = Math.random() * Math.PI * 2
) {
  const pivot = new THREE.Object3D();
  pivot.rotation.y = initialAngle;
  pivot.position.set(0, 0, 0);
  return pivot;
}

function updateOrbitalPosition(
  pivot,
  dt,
  period,
  axialTilt = 0
) {
  const speed = (2 * Math.PI) / period;
  pivot.rotation.y += speed * dt;
  if (axialTilt !== 0) {
    pivot.rotation.x = (axialTilt * Math.PI) / 180;
  }
}

function createPlanetMesh(
  radius,
  texture,
  distance,
  color = 0xffffff,
  config = {}
) {
  const geometry = new THREE.SphereGeometry(radius, 32, 32);
  const material = new THREE.MeshStandardMaterial({
    map: texture,
    color,
    roughness: config.roughness ?? 0.7,
    metalness: config.metalness ?? 0.1,
    emissive: config.emissive ?? 0x000000,
    emissiveIntensity: config.emissiveIntensity ?? 0,
  });
  const mesh = new THREE.Mesh(geometry, material);
  mesh.castShadow = true;
  mesh.receiveShadow = true;

  const pivot = new THREE.Object3D();
  mesh.position.x = distance;
  pivot.add(mesh);

  return { mesh, pivot };
}

function createSun(
  radius,
  texture,
  config = {}
) {
  const geometry = new THREE.SphereGeometry(radius, 32, 32);
  const material = new THREE.MeshBasicMaterial({
    map: texture,
  });
  const mesh = new THREE.Mesh(geometry, material);

  const glowGeometry = new THREE.SphereGeometry(radius * 1.3, 16, 16);
  const glowMaterial = new THREE.MeshBasicMaterial({
    color: 0xff8800,
    transparent: true,
    opacity: 0.15,
    side: THREE.BackSide,
  });
  const glow = new THREE.Mesh(glowGeometry, glowMaterial);
  mesh.add(glow);

  const light = new THREE.PointLight(
    0xffffff,
    config.pointLightIntensity ?? 1.5,
    config.pointLightDistance ?? 0
  );
  mesh.add(light);

  return { mesh, glow, light };
}

function createMoonMesh(
  radius,
  texture,
  orbitalDistance,
  color = 0x888888
) {
  const geometry = new THREE.SphereGeometry(radius, 16, 16);
  const material = new THREE.MeshStandardMaterial({
    map: texture,
    color,
    roughness: 0.8,
    metalness: 0.1,
  });
  const mesh = new THREE.Mesh(geometry, material);
  mesh.castShadow = true;

  const pivot = new THREE.Object3D();
  mesh.position.x = orbitalDistance;
  pivot.add(mesh);

  return { mesh, pivot };
}

function setupRaycaster(
  camera,
  domElement,
  meshes,
  onClick
) {
  const raycaster = new THREE.Raycaster();
  const mouse = new THREE.Vector2();

  domElement.addEventListener('click', (event) => {
    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
    raycaster.setFromCamera(mouse, camera);
    const intersects = raycaster.intersectObjects(meshes, true);
    if (intersects.length > 0) {
      onClick(intersects[0].object);
    }
  });
}

function setupCameraFollow(
  camera,
  controls,
  target,
  distance = 10
) {
  const direction = new THREE.Vector3(0, 0, 1).applyQuaternion(camera.quaternion);
  camera.position.copy(target).add(direction.multiplyScalar(distance));
  controls.target.copy(target);
}

function createAtmosphereGlow(
  mesh,
  color = 0x4488ff,
  intensity = 0.3
) {
  const geometry = new THREE.SphereGeometry(
    mesh.geometry.parameters.radius * 1.05,
    24,
    24
  );
  const material = new THREE.MeshBasicMaterial({
    color,
    transparent: true,
    opacity: intensity,
    side: THREE.BackSide,
  });
  const glow = new THREE.Mesh(geometry, material);
  mesh.add(glow);
  return glow;
}
